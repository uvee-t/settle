# Settle backend environment template. Never commit real credentials.
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL=
REDIS_URL=
CORS_ORIGIN=http://localhost:5173

# Gemini AI — configure the SAME values for API and worker processes.
AI_ENABLED=true
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=
AI_TIMEOUT_MS=45000
AI_MAX_INPUT_CHARS=120000
AI_MAX_OUTPUT_TOKENS=8000

# Backblaze B2 (S3-compatible)
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
B2_REGION=us-east-005
B2_BUCKET=settle
B2_KEY_ID=
B2_APPLICATION_KEY=

# PayPal
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CREDENTIALS_ENCRYPTION_KEY=
AUTH_JWT_SECRET=
