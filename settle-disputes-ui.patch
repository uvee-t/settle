+/* Dispute workspace */
+.dispute-sync-form{grid-template-columns:minmax(0,1fr) auto;align-items:end}.dispute-sync-form .formactions{margin:0}.evidence-summary{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;padding:16px 20px}.evidence-summary>div{border:1px solid var(--line);padding:12px;border-radius:4px}.evidence-summary span{display:block;color:var(--muted);font-size:11px}.evidence-summary b{display:block;font-size:19px;margin-top:6px}.claim-cell{white-space:normal;min-width:250px;max-width:540px;line-height:1.5}.evidence-actions{padding-top:16px;padding-bottom:18px}.evidence-actions .primary:disabled{opacity:.5}.panel .json{max-height:420px;overflow:auto}.dispute-sync-form input{max-width:100%}
+@media(max-width:767px){.dispute-sync-form{grid-template-columns:1fr}.evidence-summary{padding:12px;gap:6px}.evidence-summary>div{padding:9px}.evidence-summary b{font-size:16px}.evidence-actions{padding:12px;flex-wrap:wrap}.claim-cell{min-width:260px}}
